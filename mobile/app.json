{
  "expo": {
    "sdkVersion": "54.0.0",
    "name": "Gym Connect",
    "slug": "gym-connect",
    "version": "1.0.0",
    "scheme": "gymconnect",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymconnect.app"
    },
    "android": {
      "package": "com.gymconnect.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gym Connect needs access to your photos to set a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gym Connect uses your location to check you in at the gym and find gyms near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Gym Connect uses the camera to scan a gym's QR code to check in."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "af3ccf84-3069-4d1e-8b40-b072f07eac42"
      }
    },
    "owner": "shubhamgodleon"
  }
}
